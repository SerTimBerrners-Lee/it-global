[Unit]
Description=IT Global website and request delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=itglobal
Group=itglobal
WorkingDirectory=/opt/it-global
EnvironmentFile=/opt/it-global/.env
ExecStart=/usr/bin/node server/start.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
